#Использовать "../src"
#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать 1commands

Перем ЮнитТест;
Перем ВременныйКаталог;

Перем Лог;     // Объект       - объект записи лога приложения

// Процедура выполняется после запуска теста
//
Процедура ПередЗапускомТеста() Экспорт
	
	Лог = ПараметрыПриложения.Лог();
	Лог.УстановитьУровень(УровниЛога.Информация);

КонецПроцедуры // ПередЗапускомТеста()

// Функция возвращает список тестов для выполнения
//
// Параметры:
//    Тестирование    - Тестер        - Объект Тестер (1testrunner)
//    
// Возвращаемое значение:
//    Массив        - Массив имен процедур-тестов
//    
Функция ПолучитьСписокТестов(Тестирование) Экспорт
	
	ЮнитТест = Тестирование;
	
	СписокТестов = Новый Массив;
	СписокТестов.Добавить("ТестДолжен_СписокПриложенийСВерсиямиССайта1С");
	СписокТестов.Добавить("ТестДолжен_ДекодироватьРазделителиПараметровHTML");
	СписокТестов.Добавить("ТестДолжен_ОбъединитьРезультатыОбработчиковВJSONФайле");
	СписокТестов.Добавить("ТестОтчета_ИзолируетКорневыеВеткиИCallbackПорции");
	СписокТестов.Добавить("ТестОтчета_ФиксируетОшибкуЗавершения");
	СписокТестов.Добавить("ТестОтчета_ОшибкаЗаписиВозвращаетНенулевойКод");
	СписокТестов.Добавить("ТестДолжен_ЗагрузитьВерсииПриложения");
	СписокТестов.Добавить("ТестДолжен_РаспаковатьВерсииПриложения");

	Возврат СписокТестов;
	
КонецФункции // ПолучитьСписокТестов()

// Процедура выполняется после запуска теста
//
Процедура ПослеЗапускаТеста() Экспорт

КонецПроцедуры // ПослеЗапускаТеста()

// Процедура - тест
//
Процедура ТестДолжен_СписокПриложенийСВерсиямиССайта1С() Экспорт
	
	Пользователь = ПолучитьПеременнуюСреды("YARD_RELEASES_USER");
	Пароль = ПолучитьПеременнуюСреды("YARD_RELEASES_PWD");

	ПараметрыОбработки = Новый Структура();
	ПараметрыОбработки.Вставить("ИмяПользователя", Пользователь);
	
	ПараметрыОбработки.Вставить("ПарольПользователя", Пароль);
	ПараметрыОбработки.Вставить("ФильтрПриложений", "Библиотека стандартных подсистем.*3\.1");
	ПараметрыОбработки.Вставить("ФильтрВерсий", "3\.1\.3.*");
	// ПараметрыОбработки.Вставить("ФильтрВерсийНачинаяСДаты");
	// ПараметрыОбработки.Вставить("ФильтрВерсийДоДаты");
	// ПараметрыОбработки.Вставить("ПутьКФайлуДляСохранения");

	СписокРелизов = Новый СписокРелизов1С();
	СписокРелизов.УстановитьПараметрыОбработкиДанных(ПараметрыОбработки);
	СписокРелизов.ОбработатьДанные();

	Утверждения.ПроверитьБольшеИлиРавно(СписокРелизов.РезультатОбработки().Количество(),
	                                    1,
	                                    "Не удалось получить список релизов.");
	
КонецПроцедуры // ТестДолжен_СписокПриложенийСВерсиямиССайта1С()

// Процедура - проверяет декодирование разделителей параметров в адресе из HTML
//
Процедура ТестДолжен_ДекодироватьРазделителиПараметровHTML() Экспорт

	АдресСтраницыВерсииИзHTML = "/version_files?nick=DevelopmentTools10&amp;ver=2026.1.2";
	ОжидаемыйАдресСтраницыВерсии = "/version_files?nick=DevelopmentTools10&ver=2026.1.2";
	АдресИзHTML = "/version_file?nick=DevelopmentTools10&amp;ver=2026.1.2&amp;path=DevelopmentTools%5c2026_1_2";
	ОжидаемыйАдрес = "/version_file?nick=DevelopmentTools10&ver=2026.1.2&path=DevelopmentTools%5c2026_1_2";
	ДваждыКодированныйАдрес = "/version_file?nick=DevelopmentTools10&amp;amp;ver=2026.1.2";
	ОжидаемыйДваждыКодированныйАдрес = "/version_file?nick=DevelopmentTools10&amp;ver=2026.1.2";

	Утверждения.ПроверитьРавенство(
		Служебный.ДекодироватьРазделителиПараметровHTML(АдресСтраницыВерсииИзHTML),
		ОжидаемыйАдресСтраницыВерсии,
		"Разделитель параметров адреса страницы версии должен быть декодирован.");
	Утверждения.ПроверитьРавенство(
		Служебный.ДекодироватьРазделителиПараметровHTML(АдресИзHTML),
		ОжидаемыйАдрес,
		"Разделители параметров адреса должны быть декодированы.");
	Утверждения.ПроверитьРавенство(
		Служебный.ДекодироватьРазделителиПараметровHTML(ОжидаемыйАдрес),
		ОжидаемыйАдрес,
		"Адрес без HTML-сущностей не должен изменяться.");
	Утверждения.ПроверитьРавенство(
		Служебный.ДекодироватьРазделителиПараметровHTML(ДваждыКодированныйАдрес),
		ОжидаемыйДваждыКодированныйАдрес,
		"За один вызов должен декодироваться только один уровень HTML-сущностей.");
	Утверждения.ПроверитьРавенство(
		Служебный.ДобавитьПараметрЗапроса("/total", "allUpdates=true"),
		"/total?allUpdates=true",
		"Первый параметр должен добавляться через знак вопроса.");
	Утверждения.ПроверитьРавенство(
		Служебный.ДобавитьПараметрЗапроса("/total?nick=DevelopmentTools10", "allUpdates=true"),
		"/total?nick=DevelopmentTools10&allUpdates=true",
		"Следующий параметр должен добавляться через амперсанд.");

КонецПроцедуры // ТестДолжен_ДекодироватьРазделителиПараметровHTML()

// Процедура - проверяет объединение повторного приложения и новых версий в одном JSON-файле
//
Процедура ТестДолжен_ОбъединитьРезультатыОбработчиковВJSONФайле() Экспорт

	ПутьКФайлу = ОбъединитьПути(
		ТекущийКаталог(),
		СтрШаблон("yard-merge-%1.json", СокрЛП(Новый УникальныйИдентификатор())));

	ПервоеПриложение = Новый Структура(
		"Имя,Идентификатор,Версии",
		"Тестовое приложение",
		"test-app-id",
		Новый Массив());
	ПервоеПриложение.Версии.Добавить(Новый Структура("Версия,Путь", "1.0", "/release/1"));
	ПервоеПриложение.Версии.Добавить(Новый Структура("Версия,Путь", "1.1", "/release/2"));

	ВтороеПриложение = Новый Структура(
		"Имя,Идентификатор,Версии",
		"Тестовое приложение",
		"test-app-id",
		Новый Массив());
	ВтороеПриложение.Версии.Добавить(Новый Структура("Версия,Путь", "1.1", "/release/2"));
	ВтороеПриложение.Версии.Добавить(Новый Структура("Версия,Путь", "1.2", "/release/3"));

	НовоеПриложение = Новый Структура(
		"Имя,Идентификатор,Версии",
		"Другое приложение",
		"other-app-id",
		Новый Массив());
	НовоеПриложение.Версии.Добавить(Новый Структура("Версия,Путь", "2.0", "/release/4"));

	ПервыйРезультат = Новый Массив();
	ПервыйРезультат.Добавить(ПервоеПриложение);
	ВторойРезультат = Новый Массив();
	ВторойРезультат.Добавить(ВтороеПриложение);
	ВторойРезультат.Добавить(НовоеПриложение);

	Менеджер = Новый МенеджерОбработкиДанных();
	Менеджер.ДобавитьРезультатыВJSONФайл(ПутьКФайлу, ПервыйРезультат);
	Менеджер.ДобавитьРезультатыВJSONФайл(ПутьКФайлу, ВторойРезультат);
	Менеджер.ЗаписатьВсеРезультатыJSONВФайлы();

	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ПутьКФайлу, "UTF-8");
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст.ПолучитьТекст());
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Утверждения.ПроверитьРавенство(Результат.Количество(), 2, "Ожидались два приложения после объединения.");
	Утверждения.ПроверитьРавенство(
		Результат[0].Версии.Количество(),
		3,
		"Повторная версия должна быть объединена, а новая версия добавлена.");

	УдалитьФайлы(ПутьКФайлу);

КонецПроцедуры // ТестДолжен_ОбъединитьРезультатыОбработчиковВJSONФайле()

// Проверяет независимые ветки, несколько callback-порций и пропуск шагов после сбоя.
//
Процедура ТестОтчета_ИзолируетКорневыеВеткиИCallbackПорции() Экспорт

	КорневыеОбработчики = Новый Массив();

	ПараметрыПервойВетки = Новый Структура("ОшибкаОбработки", Истина);
	ПерваяВетка = ОписаниеТестовогоОбработчикаОтчета(
		ПараметрыПервойВетки,
		МассивИзОписанийТестовыхОбработчиковОтчета(Новый Структура(), Новый Массив()));
	КорневыеОбработчики.Добавить(ПерваяВетка);

	Порции = Новый Массив();
	Порции.Добавить(Новый Структура("Имя,Ключ", "Сбой", "fail"));
	Порции.Добавить(Новый Структура("Имя,Ключ", "Успех", "ok"));
	ПараметрыВторойВетки = Новый Структура("Порции", Порции);

	ПараметрыДочернего = Новый Структура(
		"ОшибкаДляКлюча,ПередаватьДальше",
		"fail",
		Истина);
	ДочерниеДочернего = Новый Массив();
	ДочерниеДочернего.Добавить(ОписаниеТестовогоОбработчикаОтчета(Новый Структура(), Новый Массив()));
	ДочерниеВторойВетки = Новый Массив();
	ДочерниеВторойВетки.Добавить(
		ОписаниеТестовогоОбработчикаОтчета(ПараметрыДочернего, ДочерниеДочернего));
	ДочерниеВторойВетки.Добавить(
		ОписаниеТестовогоОбработчикаОтчета(Новый Структура(), Новый Массив()));
	КорневыеОбработчики.Добавить(
		ОписаниеТестовогоОбработчикаОтчета(ПараметрыВторойВетки, ДочерниеВторойВетки));

	ПутьКОтчету = ПутьКВременномуОтчету("branches");
	РезультатЗапуска = ЗапуститьТестовуюОбработкуСОтчетом(КорневыеОбработчики, ПутьКОтчету);
	Если НЕ Новый Файл(ПутьКОтчету).Существует() Тогда
		ВызватьИсключение РезультатЗапуска.Вывод;
	КонецЕсли;
	Отчет = ПрочитатьJSONИзФайлаДляТеста(ПутьКОтчету);

	Утверждения.ПроверитьРавенство(РезультатЗапуска.КодВозврата <> 0, Истина,
	                              "Ошибка ветки должна приводить к ненулевому коду после записи отчета.");
	Утверждения.ПроверитьРавенство(Отчет.Обработчики.Количество(), 2,
	                              "Каждая корневая настройка должна попасть в отчет.");
	Утверждения.ПроверитьРавенство(Отчет.Обработчики[0].Статус, "ВыполненоСОшибками",
	                              "Ошибка первого корневого обработчика должна быть записана.");
	Утверждения.ПроверитьРавенство(
		Отчет.Обработчики[0].ДочерниеОбработчики[0].Статус,
		"Пропущено",
		"Дочерняя ветка корневого обработчика с ошибкой должна быть пропущена.");
	Утверждения.ПроверитьРавенство(Отчет.Обработчики[1].ОбработкиДанных.Количество(), 2,
	                              "Два вызова callback должны создать две отдельные порции.");

	ПерваяПорция = Отчет.Обработчики[1].ОбработкиДанных[0];
	Утверждения.ПроверитьРавенство(ПерваяПорция.Контекст.Приложение, "Сбой",
	                              "В контексте порции должно сохраняться имя приложения.");
	Утверждения.ПроверитьРавенство(ПерваяПорция.Статус, "Ошибка",
	                              "Сбой дочернего шага должен фиксироваться в текущей порции.");
	Утверждения.ПроверитьРавенство(
		ПерваяПорция.ДочерниеОбработчики[0].ДочерниеОбработчики[0].Статус,
		"Пропущено",
		"Дочерние шаги ошибочного обработчика должны быть пропущены.");
	Утверждения.ПроверитьРавенство(ПерваяПорция.ДочерниеОбработчики[1].Статус, "Пропущено",
	                              "Следующий обработчик той же порции должен быть пропущен.");
	Утверждения.ПроверитьРавенство(Отчет.Обработчики[1].ОбработкиДанных[1].Статус, "Успешно",
	                              "Следующая порция должна выполниться после сбоя предыдущей.");
	Утверждения.ПроверитьРавенство(Отчет.Статус, "ВыполненоСОшибками",
	                              "Итоговый статус должен учитывать ошибочную ветку.");
	Утверждения.ПроверитьРавенство(Отчет.Статистика.КорневыхОбработчиков, 2,
	                              "Статистика должна отдельно считать корневые ветки.");
	Утверждения.ПроверитьРавенство(Отчет.Статистика.ПорцийДанных, 3,
	                              "Статистика должна учитывать callback-порции на каждом уровне.");
	Утверждения.ПроверитьРавенство(Отчет.Статистика.УспешныхПорцийДанных, 2,
	                              "Статистика должна считать успешные порции.");
	Утверждения.ПроверитьРавенство(Отчет.Статистика.ПорцийДанныхСОшибками, 1,
	                              "Статистика должна считать порции с ошибками.");

	УдалитьФайлы(ПутьКОтчету);

КонецПроцедуры

// Проверяет, что ошибка финализации обработчика сохранена в JSON-отчете.
//
Процедура ТестОтчета_ФиксируетОшибкуЗавершения() Экспорт

	КорневыеОбработчики = Новый Массив();
	Порции = Новый Массив();
	Порции.Добавить(Новый Структура("Имя,Ключ", "Тестовое приложение", "ok"));
	Дочерние = Новый Массив();
	Дочерние.Добавить(ОписаниеТестовогоОбработчикаОтчета(
		Новый Структура("ОшибкаЗавершения", Истина),
		Новый Массив()));
	КорневыеОбработчики.Добавить(ОписаниеТестовогоОбработчикаОтчета(
		Новый Структура("Порции", Порции),
		Дочерние));

	ПутьКОтчету = ПутьКВременномуОтчету("completion");
	РезультатЗапуска = ЗапуститьТестовуюОбработкуСОтчетом(КорневыеОбработчики, ПутьКОтчету);
	Если НЕ Новый Файл(ПутьКОтчету).Существует() Тогда
		ВызватьИсключение РезультатЗапуска.Вывод;
	КонецЕсли;
	Отчет = ПрочитатьJSONИзФайлаДляТеста(ПутьКОтчету);

	Утверждения.ПроверитьРавенство(РезультатЗапуска.КодВозврата <> 0, Истина,
	                              "Ошибка завершения должна приводить к ненулевому коду.");
	Утверждения.ПроверитьРавенство(Отчет.Обработчики[0].ОбработкиДанных[0]
		.ДочерниеОбработчики[0].Статус, "Ошибка",
		"Ошибка завершения должна быть записана в узел обработчика.");
	Утверждения.ПроверитьРавенство(Отчет.Обработчики[0].Статус, "ВыполненоСОшибками",
	                              "Ошибка завершения должна влиять на статус корневой ветки.");

	УдалитьФайлы(ПутьКОтчету);

КонецПроцедуры

// Проверяет, что критическая ошибка записи отчета не маскируется.
//
Процедура ТестОтчета_ОшибкаЗаписиВозвращаетНенулевойКод() Экспорт

	ПутьКБлокирующемуФайлу = ПутьКВременномуОтчету("report-blocker");
	ЗаписатьJSONДляТеста(ПутьКБлокирующемуФайлу, Новый Структура("Файл", Истина));
	ПутьКОтчету = ОбъединитьПути(ПутьКБлокирующемуФайлу, "report.json");

	КорневыеОбработчики = Новый Массив();
	КорневыеОбработчики.Добавить(ОписаниеТестовогоОбработчикаОтчета(
		Новый Структура("Порции", Новый Массив()),
		Новый Массив()));
	РезультатЗапуска = ЗапуститьТестовуюОбработкуСОтчетом(КорневыеОбработчики, ПутьКОтчету);

	Утверждения.ПроверитьРавенство(РезультатЗапуска.КодВозврата <> 0, Истина,
	                              "Сбой записи отчета должен возвращать ненулевой код.");
	Утверждения.ПроверитьРавенство(
		Найти(РезультатЗапуска.Вывод, "Критическая ошибка записи отчета") > 0,
		Истина,
		СтрШаблон("Ошибка записи отчета должна быть явно показана. Вывод: %1", РезультатЗапуска.Вывод));

	УдалитьФайлы(ПутьКБлокирующемуФайлу);

КонецПроцедуры

// Создает описание обработчика для тестовой цепочки.
//
Функция ОписаниеТестовогоОбработчикаОтчета(Знач ПараметрыТестовогоОбработчика, Знач ДочерниеОбработчики)

	ПутьКОбработчику = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures",
		"ReportTestHandler.os");
	Возврат Новый Структура(
		"ИмяОбработки,ПутьКОбработке,Параметры,Обработчики",
		"ReportTestHandler",
		ПутьКОбработчику,
		ПараметрыТестовогоОбработчика,
		ДочерниеОбработчики);

КонецФункции

// Создает массив из одного описания дочернего обработчика.
//
Функция МассивИзОписанийТестовыхОбработчиковОтчета(Знач ПараметрыТестовогоОбработчика, Знач ДочерниеОбработчики)

	Результат = Новый Массив();
	Результат.Добавить(
		ОписаниеТестовогоОбработчикаОтчета(ПараметрыТестовогоОбработчика, ДочерниеОбработчики));
	Возврат Результат;

КонецФункции

// Запускает CLI с временными настройками и возвращает код и вывод процесса.
//
Функция ЗапуститьТестовуюОбработкуСОтчетом(Знач КорневыеОбработчики, Знач ПутьКОтчету)

	ПутьКНастроек = ПутьКВременномуОтчету("settings");
	ЗаписатьJSONДляТеста(ПутьКНастроек, КорневыеОбработчики);

	Команда = Новый Команда;
	Команда.УстановитьКоманду("oscript");
	Команда.УстановитьРабочийКаталог(ТекущийКаталог());
	Команда.ДобавитьПараметр(ОбъединитьПути(ТекущийКаталог(), "src", "yard.os"));
	Команда.ДобавитьПараметр("process");
	Команда.ДобавитьПараметр("--report-file");
	Команда.ДобавитьПараметр(ПутьКОтчету);
	Команда.ДобавитьПараметр(ПутьКНастроек);
	КодВозврата = Команда.Исполнить();

	Результат = Новый Структура("КодВозврата,Вывод", КодВозврата, Команда.ПолучитьВывод());
	УдалитьФайлы(ПутьКНастроек);
	Возврат Результат;

КонецФункции

// Записывает структуру в JSON-файл для запуска тестового CLI.
//
Процедура ЗаписатьJSONДляТеста(Знач ПутьКФайлу, Знач Данные)

	Запись = Новый ЗаписьJSON();
	Запись.ОткрытьФайл(ПутьКФайлу, "UTF-8");
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();

КонецПроцедуры

// Читает JSON-файл и возвращает его структуру.
//
Функция ПрочитатьJSONИзФайлаДляТеста(Знач ПутьКФайлу)

	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ПутьКФайлу, "UTF-8");
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст.ПолучитьТекст());
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Создает путь временного файла в каталоге отчетов тестов.
//
Функция ПутьКВременномуОтчету(Знач Префикс)

	Возврат ОбъединитьПути(
		ТекущийКаталог(),
		"test-reports",
		СтрШаблон("yard-%1-%2.json", Префикс, СокрЛП(Новый УникальныйИдентификатор())));

КонецФункции

