Перем МенеджерОбработкиДанных;
Перем Идентификатор;
Перем Параметры;
Перем Данные;

// Сохраняет менеджер, который передает этому тестовому обработчику.
//
Процедура ПриСозданииОбъекта(Знач Менеджер = Неопределено)

	МенеджерОбработкиДанных = Менеджер;
	Параметры = Новый Структура();

КонецПроцедуры

// Устанавливает идентификатор для вызова callback менеджера.
//
Процедура УстановитьИдентификатор(Знач НовыйИдентификатор) Экспорт

	Идентификатор = НовыйИдентификатор;

КонецПроцедуры

// Сохраняет параметры текущего тестового сценария.
//
Процедура УстановитьПараметрыОбработкиДанных(Знач НовыеПараметры) Экспорт

	Параметры = НовыеПараметры;

КонецПроцедуры

// Сохраняет входные данные дочерней порции.
//
Процедура УстановитьДанные(Знач НовыеДанные) Экспорт

	Данные = НовыеДанные;

КонецПроцедуры

// Вызывает callback для порций или имитирует сбой обработки.
//
Процедура ОбработатьДанные() Экспорт

	ОшибкаОбработки = Ложь;
	ЗначениеПараметра = Неопределено;
	Если Параметры.Свойство("ОшибкаОбработки", ЗначениеПараметра) Тогда
		ОшибкаОбработки = ЗначениеПараметра;
	КонецЕсли;
	Если ОшибкаОбработки Тогда
		ВызватьИсключение "Ошибка обработки тестового обработчика.";
	КонецЕсли;

	Если Данные = Неопределено Тогда
		Порции = Новый Массив();
		Параметры.Свойство("Порции", Порции);
		Для Каждого Порция Из Порции Цикл
			МенеджерОбработкиДанных.ПродолжениеОбработкиДанных(Порция, Идентификатор);
		КонецЦикла;
		МенеджерОбработкиДанных.ЗавершениеОбработкиДанных(Идентификатор);
		Возврат;
	КонецЕсли;

	КлючСбоя = Неопределено;
	Если Параметры.Свойство("ОшибкаДляКлюча", КлючСбоя)
	 И Данные.Свойство("Ключ")
	 И Данные.Ключ = КлючСбоя Тогда
		ВызватьИсключение "Ошибка дочерней порции тестового обработчика.";
	КонецЕсли;

	ПередаватьДальше = Ложь;
	ЗначениеПараметра = Неопределено;
	Если Параметры.Свойство("ПередаватьДальше", ЗначениеПараметра) Тогда
		ПередаватьДальше = ЗначениеПараметра;
	КонецЕсли;
	Если ПередаватьДальше Тогда
		МенеджерОбработкиДанных.ПродолжениеОбработкиДанных(Данные, Идентификатор);
	КонецЕсли;

КонецПроцедуры

// Завершает дочернюю цепочку или имитирует сбой на этапе завершения.
//
Процедура ЗавершениеОбработкиДанных() Экспорт

	ОшибкаЗавершения = Ложь;
	ЗначениеПараметра = Неопределено;
	Если Параметры.Свойство("ОшибкаЗавершения", ЗначениеПараметра) Тогда
		ОшибкаЗавершения = ЗначениеПараметра;
	КонецЕсли;
	Если ОшибкаЗавершения Тогда
		ВызватьИсключение "Ошибка завершения тестового обработчика.";
	КонецЕсли;

	МенеджерОбработкиДанных.ЗавершениеОбработкиДанных(Идентификатор);

КонецПроцедуры
